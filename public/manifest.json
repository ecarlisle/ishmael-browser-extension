{
  "manifest_version": 3,
  "name": "Ishmael",
  "version": "1.0.0",
  "description": "A natural-voice reader for the web, powered by Fish Audio.",
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": ["https://api.fish.audio/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Ishmael",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
